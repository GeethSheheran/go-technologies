20:["$","div",null,{"className":"body-copy","data-reveal":true,"children":[["$","p","Go Technologies builds digital products around the way people move, travel and experience the world.",{"children":"Go Technologies builds digital products around the way people move, travel and experience the world."}],["$","p","We combine technology, thoughtful product design and an understanding of real-world conditions to make fragmented experiences easier to coordinate.",{"children":"We combine technology, thoughtful product design and an understanding of real-world conditions to make fragmented experiences easier to coordinate."}],["$","p","We begin with travel and mobility through GoChauffeur, while building Go Technologies with room to grow beyond a single platform.",{"children":"We begin with travel and mobility through GoChauffeur, while building Go Technologies with room to grow beyond a single platform."}]]}]
